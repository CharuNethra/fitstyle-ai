# Copy to .env and fill in whichever keys you have. Every key is optional:
# with no keys the app runs end-to-end using the built-in mock AI pipeline.

PORT=5001

# --- Virtual try-on (first configured provider wins) ---
# Fal.ai (FASHN v1.6 on fal): https://fal.ai/dashboard/keys
FAL_KEY=
FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.6
# Kling VTON on fal: FAL_TRYON_MODEL=fal-ai/kling/v1-5/kolors-virtual-try-on
# FASHN direct API: https://app.fashn.ai/api
FASHN_API_KEY=

# --- Match score & complete-look styling (first configured provider wins) ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
