# Copy to .env and fill in your keys.
# Virtual try-on needs GEMINI_API_KEY; without it the Try-On page shows a "busy" message.
# Match score and styling fall back to a built-in rule engine when no AI key is set.

PORT=5001

# --- Match score & complete-look styling (first configured provider wins) ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Image model used for virtual try-on (falls back to gemini-2.5-flash-image, then retries once).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Admin portal login (unlinked page /admin/login). admin123 is a local-only default;
# in production/Vercel admin login is disabled until ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@fitstyle.ai
ADMIN_PASSWORD=admin123
# Demo JSON database for users, sessions, admin edits, offers and orders (default data/db.json; /tmp on Vercel).
# DATA_FILE=data/db.json
# Persistent storage on Vercel/serverless: add Vercel → Storage → Upstash for Redis to the project and these are set
# automatically. Without them, accounts and sessions on Vercel live in /tmp and vanish on cold starts.
# KV_REST_API_URL=https://<your-db>.upstash.io
# KV_REST_API_TOKEN=
