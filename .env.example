# Copy to .env and fill in whichever keys you have. Every key is optional:
# with no keys the app runs end-to-end using the built-in mock AI pipeline.

PORT=5001

# --- Virtual try-on ---
# huggingface (default, free): open-source IDM-VTON / OOTDiffusion on public Hugging Face Spaces.
# Other options: fal | fashn | mock
TRYON_PROVIDER=huggingface
# Optional free token (https://huggingface.co/settings/tokens) - raises the ZeroGPU daily quota.
HF_TOKEN=
# Comma-separated IDM-VTON-compatible spaces tried in order, and the OOTDiffusion space tried first for dresses.
HF_TRYON_SPACES=yisol/IDM-VTON,Nymbo/Virtual-Try-On
HF_DRESS_SPACE=levihsu/OOTDiffusion
# Fal.ai (TRYON_PROVIDER=fal, paid): https://fal.ai/dashboard/keys
FAL_KEY=
FAL_TRYON_MODEL=fal-ai/fashn/tryon/v1.6
# Kling VTON on fal: FAL_TRYON_MODEL=fal-ai/kling/v1-5/kolors-virtual-try-on
# FASHN direct API (TRYON_PROVIDER=fashn): https://app.fashn.ai/api
FASHN_API_KEY=

# --- Match score & complete-look styling (first configured provider wins) ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
